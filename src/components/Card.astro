---
interface Props {
  title: string;
  href?: string;
  eyebrow?: string;
  delay?: 0 | 1 | 2 | 3;
  class?: string;
}
const { title, href, eyebrow, delay = 0, class: className = '' } = Astro.props;
const Tag = href ? 'a' : 'div';
---
<Tag
  {...href ? { href } : {}}
  class:list={['card reveal', { 'card--link': href }, className]}
  data-delay={delay}
>
  {eyebrow && <span class="card-eyebrow">{eyebrow}</span>}
  <h3 class="card-title">{title}</h3>
  <div class="card-body"><slot /></div>
  {href && (
    <span class="card-arrow" aria-hidden="true">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7" /><path d="M7 7h10v10" /></svg>
    </span>
  )}
</Tag>

<style>
  .card {
    position: relative; display: flex; flex-direction: column; gap: 12px;
    background: linear-gradient(180deg, rgba(30, 74, 130, 0.10), rgba(30, 74, 130, 0));
    border: 1px solid var(--line); padding: clamp(22px, 3vw, 34px);
    transition: transform var(--dur-hover) var(--ease-out), border-color var(--dur-hover), background var(--dur-hover);
  }
  .card--link:hover {
    transform: translateY(-3px); border-color: var(--line-strong);
    background: linear-gradient(180deg, rgba(30, 74, 130, 0.22), rgba(30, 74, 130, 0.04));
  }
  .card-eyebrow { font-family: var(--font-mono); font-size: 10px; text-transform: uppercase; letter-spacing: var(--tracking-mega); color: var(--ciaf-on-navy-55); }
  .card-title { font-family: var(--font-display); font-weight: 800; text-transform: uppercase; letter-spacing: -0.01em; font-size: clamp(18px, 2vw, 24px); line-height: 1.05; color: #fff; }
  .card-body { color: var(--ciaf-on-navy-60); font-size: 15px; }
  .card-arrow { position: absolute; top: clamp(22px, 3vw, 34px); right: clamp(22px, 3vw, 34px); color: var(--ciaf-on-navy-55); opacity: 0; transform: translate(-4px, 4px); transition: opacity var(--dur-hover), transform var(--dur-hover); }
  .card--link:hover .card-arrow { opacity: 1; transform: none; color: #fff; }
  /* En mobile (sin hover) la flecha queda visible para señalar que es clickable */
  @media (hover: none) { .card--link .card-arrow { opacity: 0.7; transform: none; } }

  /* En secciones claras */
  :global(.section--paper) .card { background: #fff; border-color: var(--line-dark); }
  :global(.section--paper) .card-title { color: var(--ink); }
  :global(.section--paper) .card-body { color: rgba(26, 26, 26, 0.62); }
  :global(.section--paper) .card-eyebrow { color: var(--brand); }
  :global(.section--paper) .card--link:hover { border-color: var(--ink); }
</style>
