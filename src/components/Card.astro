---
interface Props {
  title: string;
  href?: string;
  eyebrow?: string;
  delay?: 0 | 1 | 2 | 3;
  class?: string;
}
const { title, href, eyebrow, delay = 0, class: className = '' } = Astro.props;
const Tag = href ? 'a' : 'div';
---
<Tag
  {...href ? { href } : {}}
  class:list={['card reveal', { 'card--link': href }, className]}
  data-delay={delay}
>
  {eyebrow && <span class="card-eyebrow">{eyebrow}</span>}
  <h3 class="card-title">{title}</h3>
  <div class="card-body"><slot /></div>
  {href && (
    <span class="card-arrow" aria-hidden="true">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7" /><path d="M7 7h10v10" /></svg>
    </span>
  )}
</Tag>

<style>
  .card {
    position: relative; display: flex; flex-direction: column; gap: 12px;
    background: linear-gradient(180deg, rgba(46, 125, 83, 0.10), rgba(46, 125, 83, 0));
    border: 1px solid var(--line); border-left: 3px solid transparent;
    padding: clamp(22px, 3vw, 34px);
    clip-path: polygon(0 0, calc(100% - 22px) 0, 100% 22px, 100% 100%, 0 100%);
    transition: transform var(--dur-hover) var(--ease-out), border-color var(--dur-hover), background var(--dur-hover);
  }
  .card--link:hover {
    transform: translateY(-3px); border-color: var(--line-strong); border-left-color: var(--gold);
    background: linear-gradient(180deg, rgba(46, 125, 83, 0.22), rgba(46, 125, 83, 0.04));
  }
  .card-eyebrow { font-family: var(--font-mono); font-size: 10px; text-transform: uppercase; letter-spacing: var(--tracking-mega); color: var(--camca-on-navy-55); }
  .card-title { font-family: var(--font-display); font-weight: 700; text-transform: uppercase; letter-spacing: 0.005em; font-size: clamp(20px, 2.2vw, 27px); line-height: 1.02; color: #fff; }
  .card-body { color: var(--camca-on-navy-60); font-size: 15px; }
  .card-arrow { position: absolute; top: clamp(22px, 3vw, 34px); right: clamp(22px, 3vw, 34px); color: var(--camca-on-navy-55); opacity: 0; transform: translate(-4px, 4px); transition: opacity var(--dur-hover), transform var(--dur-hover); }
  .card--link:hover .card-arrow { opacity: 1; transform: none; color: #fff; }
  /* En mobile (sin hover) la flecha queda visible para señalar que es clickable */
  @media (hover: none) { .card--link .card-arrow { opacity: 0.7; transform: none; } }

  /* En secciones claras */
  :global(.section--paper) .card { background: #fff; border-color: var(--line-dark); }
  :global(.section--paper) .card-title { color: var(--ink); }
  :global(.section--paper) .card-body { color: rgba(26, 26, 26, 0.62); }
  :global(.section--paper) .card-eyebrow { color: var(--brand); }
  :global(.section--paper) .card--link:hover { border-color: var(--ink); }
</style>
