---
// Sección "Stack / 12" portada TAL CUAL del brochure (ciaf-brochure-pdf.html).
// PCB animado de integraciones. CSS y JS verbatim; solo se ajusta la ruta de logos.
//
// Fallback responsive: en <768px el PCB es ilegible, así que se muestra una grilla
// legible con el MISMO contenido. Los datos deben mantenerse en sync con el array
// SYSTEMS del <script> de abajo (mismo orden/categorías).
const CATS = {
  gastro: { label: 'Gastronomía', color: '#F5A623' },
  retail: { label: 'Retail & Comercio', color: '#3DD6F5' },
  hotel: { label: 'Hotelería', color: '#3DE6B4' },
  erp: { label: 'ERP & Gestión', color: '#A78BFA' },
  finanzas: { label: 'Contabilidad', color: '#5EE3A0' },
  bi: { label: 'BI & Reporting', color: '#FFD24D' },
  ia: { label: 'IA · Transversal', color: '#C2A2FB' },
} as const;
const SYSTEMS = [
  { name: 'Gestión Cervecera', sub: 'Cervecerías', cat: 'gastro', logo: 'gestion-cervecera.png' },
  { name: 'Fudo', sub: 'Franquicias', cat: 'gastro', logo: 'fudo.svg' },
  { name: 'Maxirest', sub: 'Gastronomía', cat: 'gastro', logo: 'maxirest.svg' },
  { name: 'Toteat', sub: 'Restaurantes', cat: 'gastro', logo: 'toteat.svg' },
  { name: 'Bistrosoft', sub: 'Restaurantes', cat: 'gastro', logo: 'bistrosoft.webp' },
  { name: 'Control Comercio', sub: 'Comercio', cat: 'retail', logo: 'control-comercio.webp' },
  { name: 'Dragonfish', sub: 'Moda', cat: 'retail', logo: 'dragonfish.png' },
  { name: 'Optix', sub: 'Ópticas', cat: 'retail', logo: 'optix.webp' },
  { name: 'PxSol', sub: 'Hotelería', cat: 'hotel', logo: 'pxsol.svg' },
  { name: 'Odoo', sub: 'ERP', cat: 'erp', logo: 'odoo.png' },
  { name: 'AdministraNET', sub: 'Gestión', cat: 'erp', logo: 'administranet.svg', dark: true },
  { name: 'Contabilium', sub: 'Finanzas', cat: 'finanzas', logo: 'contabilium.webp' },
  { name: 'SGC', sub: 'Contabilidad', cat: 'finanzas', logo: 'sgc.png' },
  { name: 'SOS Contador', sub: 'Contador', cat: 'finanzas', logo: 'sos-contador.png' },
  { name: 'Power BI', sub: 'BI / Reporting', cat: 'bi', logo: 'powerbi.png' },
  { name: 'Looker Studio', sub: 'BI / Reporting', cat: 'bi', logo: 'looker-studio.svg' },
  { name: 'Gemini', sub: 'IA Generativa', cat: 'ia', logo: 'gemini.png' },
  { name: 'Claude', sub: 'IA Asistente', cat: 'ia', logo: 'claude.png' },
  { name: 'OpenCode', sub: 'IA Código', cat: 'ia', logo: 'opencode.svg' },
] as const;
const catOrder = ['gastro', 'retail', 'hotel', 'erp', 'finanzas', 'bi', 'ia'] as const;
const grouped = catOrder
  .map((c) => ({ cat: c, meta: CATS[c], items: SYSTEMS.filter((s) => s.cat === c) }))
  .filter((g) => g.items.length > 0);
---
<section id="stack" class="stack-section">
  <div class="container">
    <div class="stack-head">
      <div class="stack-head-main reveal">
        <span class="ribbon">Stack / 12</span>
        <h2 class="h2 stack-title">Operamos<br />sobre tu stack.</h2>
        <p class="stack-copy">Trabajamos directamente sobre los sistemas que ya usás, o te ayudamos a elegir e implementar el correcto. Y cuando hace falta, desarrollamos software a medida e implementamos IA en tu operación.</p>
      </div>
      <div class="stack-head-side reveal" data-delay="1">
        <div class="eyebrow stack-side-label">// Integraciones activas</div>
        <div class="stack-side-big">19 sistemas conectados</div>
        <div class="stack-side-sub">6 industrias · capa transversal IA</div>
      </div>
    </div>

    <!-- Leyenda de categorías -->
    <div class="reveal pcb-legend" id="pcb-legend">
      <span class="pcb-legend-label">// Categorías</span>
    </div>

    <!-- Canvas PCB -->
    <div class="reveal pcb-outer">
      <div class="pcb-canvas" id="pcb-canvas">
        <div class="pcb-grid"></div>
        <svg class="pcb-svg" viewBox="0 0 1500 1280" preserveAspectRatio="xMidYMid meet">
          <defs>
            <radialGradient id="pcbChipGlow" cx="50%" cy="50%" r="50%">
              <stop offset="0%" stop-color="rgba(245,166,35,0.45)" />
              <stop offset="60%" stop-color="rgba(245,166,35,0.08)" />
              <stop offset="100%" stop-color="rgba(245,166,35,0)" />
            </radialGradient>
          </defs>
          <ellipse cx="750" cy="540" rx="420" ry="360" fill="url(#pcbChipGlow)" />
          <g id="pcb-traces"></g>
        </svg>
        <!-- Chip -->
        <div class="pcb-chip">
          <div class="pcb-chip-pins"></div>
          <div class="pcb-chip-body">
            <div class="pcb-chip-innergrid"></div>
            <div class="pcb-chip-notch"></div>
            <div class="pcb-chip-dots"><i></i><i></i></div>
            <div class="pcb-chip-version">v.2026</div>
            <div class="pcb-chip-center">
              <div class="pcb-chip-title">CIAF</div>
              <div class="pcb-chip-sub">HUB · INTEGRACIÓN</div>
              <div class="pcb-chip-divider">
                <div class="pcb-chip-tagline">Un cerebro para<br />toda tu operación</div>
              </div>
            </div>
            <div class="pcb-chip-serial">◆ CIAF-CORE / 19CH ◆</div>
          </div>
        </div>
        <!-- Pills generadas por JS -->
        <div id="pcb-pills"></div>
      </div>
    </div>

    <!-- Status footer -->
    <div class="reveal pcb-status">
      <div><span class="pcb-pulse"></span>UPLINK ONLINE <span style="opacity:.6;margin-left:8px">// 19 CANALES · DATA SYNC RT</span></div>
      <div>CIAF.IO/STACK · 2026</div>
    </div>

    <!-- Fallback legible para mobile (<768px): mismo contenido, sin el PCB -->
    <div class="stack-fallback reveal">
      {grouped.map((g) => (
        <div class="sf-group">
          <div class="sf-cat"><span class="sf-dot" style={`background:${g.meta.color}`}></span>{g.meta.label}</div>
          <ul class="sf-list">
            {g.items.map((s) => (
              <li class="sf-item">
                <span class:list={['sf-mark', { 'is-dark': 'dark' in s && s.dark }]} style={`--c:${g.meta.color}`}>
                  <img
                    src={`/integraciones/${s.logo}`}
                    alt={s.name}
                    loading="lazy"
                    decoding="async"
                    onerror={`this.outerHTML='<b class=&quot;sf-fb&quot;>${s.name.slice(0, 2).toUpperCase()}</b>'`}
                  />
                </span>
                <span class="sf-text"><span class="sf-name">{s.name}</span><span class="sf-sub">{s.sub}</span></span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .stack-section { padding-block: var(--section-pad-y); border-top: 1px solid var(--line); }
  .stack-head { display: grid; grid-template-columns: 7fr 5fr; gap: var(--space-lg); align-items: end; }
  .stack-title { margin-top: var(--space-md); font-size: clamp(34px, 5vw, 52px); }
  .stack-copy { margin-top: var(--space-md); color: var(--ciaf-on-navy-60); max-width: 46ch; }
  .stack-head-side { text-align: right; }
  .stack-side-label { margin-bottom: 8px; }
  .stack-side-big { font-family: var(--font-display); font-weight: 800; text-transform: uppercase; letter-spacing: -0.01em; font-size: clamp(18px, 2vw, 22px); color: rgba(255,255,255,.85); line-height: 1.1; }
  .stack-side-sub { color: var(--ciaf-on-navy-60); font-size: 14px; margin-top: 6px; }

  /* ── Fallback mobile (oculto por defecto; reemplaza al PCB en <768px) ── */
  .stack-fallback { display: none; margin-top: var(--space-lg); }
  .sf-group { padding-top: var(--space-md); margin-top: var(--space-md); border-top: 1px dashed rgba(255,255,255,.10); }
  .sf-group:first-child { border-top: 0; margin-top: 0; }
  .sf-cat { display: flex; align-items: center; gap: 8px; font-family: var(--font-mono); font-size: 11px; letter-spacing: 1.5px; text-transform: uppercase; color: var(--ciaf-on-navy-60); margin-bottom: 12px; }
  .sf-dot { width: 8px; height: 8px; border-radius: 50%; box-shadow: 0 0 8px currentColor; flex-shrink: 0; }
  .sf-list { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .sf-item { display: flex; align-items: center; gap: 10px; min-width: 0; padding: 8px; background: rgba(255,255,255,.03); border: 1px solid var(--line); border-radius: 8px; }
  .sf-mark { width: 38px; height: 38px; flex-shrink: 0; border-radius: 9px; background: #fff; display: flex; align-items: center; justify-content: center; padding: 5px; box-shadow: inset 0 0 0 1.5px color-mix(in srgb, var(--c) 55%, transparent); }
  .sf-mark.is-dark { background: #13162a; box-shadow: inset 0 0 0 1.5px color-mix(in srgb, var(--c) 65%, transparent); }
  .sf-mark img { max-width: 100%; max-height: 100%; object-fit: contain; }
  .sf-fb { font-family: var(--font-display); font-weight: 800; font-size: 13px; color: #0a1628; }
  .sf-mark.is-dark .sf-fb { color: #fff; }
  .sf-text { display: flex; flex-direction: column; min-width: 0; }
  .sf-name { font-family: var(--font-display); font-weight: 700; font-size: 12.5px; text-transform: uppercase; letter-spacing: .3px; color: #fff; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .sf-sub { font-family: var(--font-mono); font-size: 9px; text-transform: uppercase; letter-spacing: .5px; color: var(--ciaf-on-navy-55); }
  @media (max-width: 480px) { .sf-list { grid-template-columns: 1fr; } }

  /* El PCB es un visual de escritorio: por debajo de 1024px se ve apretado (y en el
     rango angosto ~768px el escalado por JS queda en blanco). En tablet/mobile usamos
     el fallback legible con el MISMO contenido; el PCB solo se muestra en >=1024px. */
  @media (max-width: 1023px) {
    .pcb-outer, .pcb-legend, .pcb-status { display: none !important; }
    .stack-fallback { display: block; }
  }
  /* Tablet: aprovechar el ancho con 3 columnas en la lista de sistemas */
  @media (min-width: 681px) and (max-width: 1023px) {
    .sf-list { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 820px) { .stack-head { grid-template-columns: 1fr; gap: var(--space-md); } .stack-head-side { text-align: left; } }

  /* ── PCB Stack (Stack / 12) — verbatim del brochure ── */
  .pcb-outer{ position:relative; width:100%; margin-top:var(--space-lg); overflow:hidden; }
  .pcb-canvas{
    position:relative; width:1500px; height:1280px;
    background:radial-gradient(ellipse at 50% 55%, #112849 0%, #07101f 65%);
    transform-origin:0 0; border-radius:12px; overflow:hidden;
  }
  .pcb-grid{
    position:absolute; inset:0; pointer-events:none;
    background-image:
      linear-gradient(rgba(255,255,255,.025) 1px,transparent 1px),
      linear-gradient(90deg,rgba(255,255,255,.025) 1px,transparent 1px);
    background-size:40px 40px;
  }
  .pcb-svg{ position:absolute; inset:0; width:100%; height:100%; pointer-events:none; overflow:visible; }

  /* Chip */
  .pcb-chip{ position:absolute; left:600px; top:380px; width:300px; height:320px; }
  .pcb-chip-body{
    position:absolute; top:14px; left:14px; right:14px; bottom:14px;
    border-radius:18px;
    background:linear-gradient(160deg,#1f4790 0%,#15356d 55%,#0e2a5c 100%);
    box-shadow:0 0 0 1.5px rgba(245,166,35,.85),0 0 80px rgba(245,166,35,.35),
      inset 0 1px 0 rgba(255,255,255,.18),inset 0 -20px 40px rgba(0,0,0,.35);
    overflow:hidden; display:flex; flex-direction:column;
    align-items:center; justify-content:center;
  }
  .pcb-chip-innergrid{
    position:absolute; inset:0; pointer-events:none;
    background-image:linear-gradient(rgba(255,255,255,.04) 1px,transparent 1px),
      linear-gradient(90deg,rgba(255,255,255,.04) 1px,transparent 1px);
    background-size:20px 20px;
  }
  .pcb-chip-notch{
    position:absolute; top:0; left:50%; transform:translateX(-50%);
    width:36px; height:6px; background:#F5A623; border-radius:0 0 6px 6px;
  }
  .pcb-chip-dots{ position:absolute; top:12px; left:12px; display:flex; gap:5px; }
  .pcb-chip-dots i{ display:block; width:5px; height:5px; border-radius:50%; font-style:normal; }
  .pcb-chip-dots i:first-child{ background:#F5A623; box-shadow:0 0 6px #F5A623; }
  .pcb-chip-dots i:last-child{ background:rgba(255,255,255,.3); }
  .pcb-chip-version{
    position:absolute; top:10px; right:12px;
    font-family:'JetBrains Mono',monospace; font-size:9px; color:rgba(255,255,255,.5);
  }
  .pcb-chip-center{ position:relative; text-align:center; z-index:1; }
  .pcb-chip-title{
    font-family:'Montserrat',sans-serif; font-weight:800;
    font-size:72px; color:#fff; letter-spacing:.045em; line-height:.88;
    text-shadow:0 2px 14px rgba(0,0,0,.5);
  }
  .pcb-chip-sub{
    margin-top:16px; font-family:'JetBrains Mono',monospace;
    font-size:11px; color:#F5A623; letter-spacing:3.5px;
  }
  .pcb-chip-divider{
    border-top:1px solid rgba(255,255,255,.14); margin:12px auto 0; padding-top:12px;
  }
  .pcb-chip-tagline{
    font-family:'Montserrat',sans-serif; font-weight:400; font-size:12px;
    color:rgba(255,255,255,.78); line-height:1.5; max-width:220px; margin:0 auto;
  }
  .pcb-chip-serial{
    position:absolute; bottom:10px;
    font-family:'JetBrains Mono',monospace; font-size:8.5px;
    color:rgba(255,255,255,.35); letter-spacing:1px;
  }
  /* NOTA: los estilos de .pcb-pin / .pcb-pill* / .pcb-cat-pill (elementos creados por
     el <script> en runtime) viven en el bloque <style is:global> de abajo, porque Astro
     no aplica estilos scoped a nodos generados por JS. Acá quedan solo los de plantilla. */

  /* Legend + footer */
  .pcb-legend{
    border-top:1px dashed rgba(255,255,255,.08);
    padding-top:14px; margin-top:var(--space-lg); margin-bottom:10px;
    display:flex; flex-wrap:wrap; align-items:center; gap:8px;
  }
  .pcb-legend-label{
    font-family:'JetBrains Mono',monospace; font-size:10px;
    color:#5C7595; letter-spacing:2px; text-transform:uppercase; margin-right:4px;
  }
  .pcb-status{
    border-top:1px dashed rgba(255,255,255,.08); padding-top:14px; margin-top:12px;
    display:flex; justify-content:space-between; align-items:center;
    flex-wrap:wrap; gap:12px;
    font-family:'JetBrains Mono',monospace; font-size:11px;
    letter-spacing:1.4px; color:#5C7595; text-transform:uppercase;
  }
  .pcb-pulse{
    display:inline-block; width:7px; height:7px; border-radius:50%;
    background:#5EE3A0; margin-right:8px;
    animation:pcb-pulse-glow 1.6s infinite;
  }
  @keyframes pcb-pulse-glow{ 0%,100%{ opacity:.4;transform:scale(1) } 50%{ opacity:.9;transform:scale(1.15) } }
</style>

<!-- ── Estilos GLOBALES de los elementos generados por JS (pines, pills, leyenda) ──
     Astro scopea <style> por defecto (.clase[data-astro-cid-…]); los nodos creados en
     runtime por el <script> NO reciben ese atributo, así que las reglas scoped no les
     aplican y las pills caían sin position:absolute al flujo normal (apiladas a la
     izquierda). Se globalizan acotadas a #stack para no filtrar al resto del sitio.
     El keyframe pcb-pulse-trace también va global porque el JS lo referencia por nombre. -->
<style is:global>
  #stack .pcb-pin{
    position:absolute; background:rgba(180,210,255,.55);
    border-radius:2px; box-shadow:0 0 6px rgba(245,166,35,.6);
  }

  #stack .pcb-pill{
    position:absolute; display:flex; align-items:center; gap:9px;
    padding:6px 12px 6px 6px; height:64px;
    background:#fbfcfe; border-radius:999px;
    border:1.5px solid var(--cat-color,#ccc);
    box-shadow:0 6px 20px rgba(0,0,0,.35),0 0 0 1px rgba(255,255,255,.05);
    transition:transform .25s cubic-bezier(.22,.61,.36,1), box-shadow .25s cubic-bezier(.22,.61,.36,1), opacity .25s, filter .25s;
    cursor:default; transform:translate(-50%,-50%); z-index:2;
    box-sizing:border-box;
  }
  #stack .pcb-pill.is-dim{ opacity:.35; filter:saturate(.6); }
  #stack .pcb-pill:hover{
    transform:translate(-50%,-50%) translateY(-2px); z-index:10;
    box-shadow:0 10px 32px rgba(0,0,0,.55),0 0 0 1px rgba(255,255,255,.1);
  }
  #stack .pcb-pill-mark{
    width:44px; height:44px; border-radius:10px; flex-shrink:0;
    background:#fff; display:flex; align-items:center; justify-content:center;
    box-shadow:inset 0 0 0 1.5px color-mix(in srgb, var(--cat-color) 55%, transparent); padding:5px;
  }
  #stack .pcb-pill-mark.is-dark{ background:#13162a; box-shadow:inset 0 0 0 1.5px color-mix(in srgb, var(--cat-color) 65%, transparent); }
  #stack .pcb-pill-logo{ max-width:100%; max-height:100%; object-fit:contain; display:block; }
  #stack .pcb-pill-text{ overflow:hidden; min-width:0; flex:1; }
  #stack .pcb-pill-name{
    font-family:'Montserrat',sans-serif; font-weight:700; font-size:13.5px;
    color:#0a1628; letter-spacing:.3px; text-transform:uppercase;
    white-space:nowrap; overflow:hidden; text-overflow:ellipsis; line-height:1.2;
  }
  #stack .pcb-pill-sub{
    font-family:'JetBrains Mono',monospace; font-size:9.5px;
    text-transform:uppercase; color:var(--cat-dim,#666);
    letter-spacing:1px; margin-top:3px; line-height:1.2;
  }

  #stack .pcb-cat-pill{
    display:inline-flex; align-items:center; gap:7px; border-radius:999px;
    padding:7px 14px; background:rgba(255,255,255,.025);
    border:1px solid rgba(255,255,255,.08);
    font-family:'Montserrat',sans-serif; font-weight:600; font-size:11px;
    text-transform:uppercase; color:#e7ecf3; letter-spacing:.5px;
    cursor:pointer; transition:background .2s, border-color .2s;
  }
  #stack .pcb-cat-pill:hover{ background:rgba(255,255,255,.06); border-color:var(--cat-color); }
  #stack .pcb-cat-pill:focus-visible{ outline:2px solid var(--cat-color); outline-offset:2px; }
  #stack .pcb-cat-pill .dot{
    width:8px; height:8px; border-radius:50%; background:var(--cat-color);
    box-shadow:0 0 10px var(--cat-color); flex-shrink:0;
  }

  @keyframes pcb-pulse-trace{ 0%,100%{ stroke-opacity:.22 } 50%{ stroke-opacity:.70 } }

  @media (prefers-reduced-motion: reduce){
    #stack .pcb-pill{ transition:none; }
  }
</style>

<script>
  /* ============= PCB STACK — verbatim del brochure (ruta de logos: /integraciones/) ============= */
  (function () {
    var CATS = {
      gastro: { label: 'Gastronomía', color: '#F5A623', dim: '#7d5310' },
      retail: { label: 'Retail & Comercio', color: '#3DD6F5', dim: '#0f6479' },
      hotel: { label: 'Hotelería', color: '#3DE6B4', dim: '#0f6e56' },
      erp: { label: 'ERP & Gestión', color: '#A78BFA', dim: '#4e3d8f' },
      finanzas: { label: 'Contabilidad', color: '#5EE3A0', dim: '#1f6e44' },
      bi: { label: 'BI & Reporting', color: '#FFD24D', dim: '#7d6310' },
      ia: { label: 'IA · Transversal', color: '#C2A2FB', dim: '#5a3fa8' },
    };

    var SYSTEMS = [
      { row: 0, col: 0, name: 'Gestión Cervecera', sub: 'Cervecerías', cat: 'gastro', logo: 'gestion-cervecera.png' },
      { row: 0, col: 1, name: 'Fudo', sub: 'Franquicias', cat: 'gastro', logo: 'fudo.svg' },
      { row: 0, col: 2, name: 'Maxirest', sub: 'Gastronomía', cat: 'gastro', logo: 'maxirest.svg' },
      { row: 0, col: 3, name: 'Toteat', sub: 'Restaurantes', cat: 'gastro', logo: 'toteat.svg' },
      { row: 1, col: 0, name: 'Bistrosoft', sub: 'Restaurantes', cat: 'gastro', logo: 'bistrosoft.webp' },
      { row: 1, col: 1, name: 'Control Comercio', sub: 'Comercio', cat: 'retail', logo: 'control-comercio.webp' },
      { row: 1, col: 2, name: 'Dragonfish', sub: 'Moda', cat: 'retail', logo: 'dragonfish.png' },
      { row: 1, col: 3, name: 'Optix', sub: 'Ópticas', cat: 'retail', logo: 'optix.webp' },
      { row: 2, col: 0, name: 'PxSol', sub: 'Hotelería', cat: 'hotel', logo: 'pxsol.svg' },
      { row: 2, col: 1, name: 'Odoo', sub: 'ERP', cat: 'erp', logo: 'odoo.png' },
      { row: 2, col: 2, name: 'Power BI', sub: 'BI / Reporting', cat: 'bi', logo: 'powerbi.png' },
      { row: 2, col: 3, name: 'Looker Studio', sub: 'BI / Reporting', cat: 'bi', logo: 'looker-studio.svg' },
      { row: 3, col: 0, name: 'AdministraNET', sub: 'Gestión', cat: 'erp', logo: 'administranet.svg', dark: true },
      { row: 3, col: 1, name: 'Contabilium', sub: 'Finanzas', cat: 'finanzas', logo: 'contabilium.webp' },
      { row: 3, col: 2, name: 'SGC', sub: 'Contabilidad', cat: 'finanzas', logo: 'sgc.png' },
      { row: 3, col: 3, name: 'SOS Contador', sub: 'Contador', cat: 'finanzas', logo: 'sos-contador.png' },
      { row: 4, col: 0, cx: 400, name: 'Gemini', sub: 'IA Generativa', cat: 'ia', logo: 'gemini.png' },
      { row: 4, col: 1, cx: 750, name: 'Claude', sub: 'IA Asistente', cat: 'ia', logo: 'claude.png' },
      { row: 4, col: 2, cx: 1100, name: 'OpenCode', sub: 'IA Código', cat: 'ia', logo: 'opencode.svg' },
    ];

    var W = 1500, H = 1280;
    var CHIP_W = 300, CHIP_H = 320, CHIP_FRAME = 14;
    var CHIP_LEFT = 600, CHIP_TOP = 380, CHIP_RIGHT = 900, CHIP_BOTTOM = 700;
    var PILL_H = 64, PIN_N = 7;
    var ROW_Y = [110, 320, 760, 970, 1180];
    var COL_X = [140, 420, 1080, 1360];
    var IA_PINS = [660, 750, 840];

    function pillWidth(name) { return Math.max(184, Math.min(308, 82 + name.length * 10.8)); }

    function chipPin(row, col) {
      if (row === 0) return { x: CHIP_LEFT + (col + 0.5) / 4 * CHIP_W, y: CHIP_TOP, side: 'top' };
      if (row === 3) return { x: CHIP_LEFT + (col + 0.5) / 4 * CHIP_W, y: CHIP_BOTTOM, side: 'bottom' };
      if (row === 4) return { x: IA_PINS[col], y: CHIP_BOTTOM, side: 'bottom' };
      if (col <= 1) { var idx = (row - 1) * 2 + col; return { x: CHIP_LEFT, y: CHIP_TOP + (idx + 0.5) / 4 * CHIP_H, side: 'left' }; }
      var idx2 = (row - 1) * 2 + (col - 2); return { x: CHIP_RIGHT, y: CHIP_TOP + (idx2 + 0.5) / 4 * CHIP_H, side: 'right' };
    }

    function pillExit(cx, cy, pw, pin) {
      if (pin.side === 'top') return { x: cx, y: cy + PILL_H / 2 };
      if (pin.side === 'bottom') return { x: cx, y: cy - PILL_H / 2 };
      if (pin.side === 'left') return { x: cx + pw / 2, y: cy };
      return { x: cx - pw / 2, y: cy };
    }

    function buildPath(exit, pin, col) {
      var ex = exit.x, ey = exit.y, px = pin.x, py = pin.y, side = pin.side;
      if (side === 'top') {
        var ry = ey + 36 + col * 14;
        return { d: 'M ' + ex + ' ' + ey + ' L ' + ex + ' ' + ry + ' L ' + px + ' ' + ry + ' L ' + px + ' ' + py, bends: [{ x: ex, y: ry }, { x: px, y: ry }] };
      }
      if (side === 'bottom') {
        var ry2 = ey - 36 - col * 14;
        return { d: 'M ' + ex + ' ' + ey + ' L ' + ex + ' ' + ry2 + ' L ' + px + ' ' + ry2 + ' L ' + px + ' ' + py, bends: [{ x: ex, y: ry2 }, { x: px, y: ry2 }] };
      }
      if (side === 'left') {
        var gap = Math.abs(ex - px);
        var rx = Math.min(ex + Math.max(34, gap * 0.4) + col * 14, CHIP_LEFT - 28);
        return { d: 'M ' + ex + ' ' + ey + ' L ' + rx + ' ' + ey + ' L ' + rx + ' ' + py + ' L ' + px + ' ' + py, bends: [{ x: rx, y: ey }, { x: rx, y: py }] };
      }
      var gap2 = Math.abs(ex - px);
      var rx2 = Math.max(ex - Math.max(34, gap2 * 0.4) - (col - 2) * 14, CHIP_RIGHT + 28);
      return { d: 'M ' + ex + ' ' + ey + ' L ' + rx2 + ' ' + ey + ' L ' + rx2 + ' ' + py + ' L ' + px + ' ' + py, bends: [{ x: rx2, y: ey }, { x: rx2, y: py }] };
    }

    var canvas = document.getElementById('pcb-canvas');
    var traceG = document.getElementById('pcb-traces');
    var pillsEl = document.getElementById('pcb-pills');
    var legendEl = document.getElementById('pcb-legend');
    var outer = document.querySelector('.pcb-outer');
    if (!canvas) return;

    function updateScale() {
      if (!outer) return;
      var scale = outer.clientWidth / W;
      canvas.style.transform = 'scale(' + scale + ')';
      outer.style.height = (H * scale) + 'px';
    }
    window.addEventListener('resize', updateScale);

    var pinsEl = canvas.querySelector('.pcb-chip-pins');
    if (pinsEl) {
      ['top', 'bottom', 'left', 'right'].forEach(function (side) {
        for (var i = 0; i < PIN_N; i++) {
          var t = (i + 0.5) / PIN_N;
          var isVert = side === 'top' || side === 'bottom';
          var pw = isVert ? 6 : 14, ph = isVert ? 14 : 6;
          var pl, pt;
          if (side === 'top') { pl = CHIP_FRAME + t * (CHIP_W - 2 * CHIP_FRAME) - pw / 2; pt = 0; }
          else if (side === 'bottom') { pl = CHIP_FRAME + t * (CHIP_W - 2 * CHIP_FRAME) - pw / 2; pt = CHIP_H - ph; }
          else if (side === 'left') { pl = 0; pt = CHIP_FRAME + t * (CHIP_H - 2 * CHIP_FRAME) - ph / 2; }
          else { pl = CHIP_W - pw; pt = CHIP_FRAME + t * (CHIP_H - 2 * CHIP_FRAME) - ph / 2; }
          var pin = document.createElement('div');
          pin.className = 'pcb-pin';
          pin.style.cssText = 'left:' + pl + 'px;top:' + pt + 'px;width:' + pw + 'px;height:' + ph + 'px';
          pinsEl.appendChild(pin);
        }
      });
    }

    Object.keys(CATS).forEach(function (key) {
      var cat = CATS[key];
      var btn = document.createElement('button');
      btn.className = 'pcb-cat-pill';
      btn.dataset.cat = key;
      btn.style.setProperty('--cat-color', cat.color);
      btn.innerHTML = '<span class="dot"></span>' + cat.label;
      btn.addEventListener('mouseenter', function () { filterByCat(key); });
      btn.addEventListener('mouseleave', function () { filterByCat(null); });
      legendEl.appendChild(btn);
    });

    var pillEls = {}, traceEls = {};
    var SVG_NS = 'http://www.w3.org/2000/svg';
    function svgEl(tag) { return document.createElementNS(SVG_NS, tag); }

    SYSTEMS.forEach(function (sys, i) {
      var cat = CATS[sys.cat];
      var cx = sys.cx !== undefined ? sys.cx : COL_X[sys.col];
      var cy = ROW_Y[sys.row];
      var pw = pillWidth(sys.name);
      var pin = chipPin(sys.row, sys.col);
      var exit = pillExit(cx, cy, pw, pin);
      var path = buildPath(exit, pin, sys.col);
      var delay = (sys.row * 4 + sys.col) * 0.45;
      var pulseDelay = (sys.row + sys.col) * 0.4;

      var traceEl = svgEl('path');
      traceEl.setAttribute('d', path.d);
      traceEl.setAttribute('stroke', cat.color);
      traceEl.setAttribute('stroke-width', '1.1');
      traceEl.setAttribute('stroke-opacity', '0.32');
      traceEl.setAttribute('stroke-linecap', 'round');
      traceEl.setAttribute('stroke-linejoin', 'round');
      traceEl.setAttribute('fill', 'none');
      traceEl.style.animation = 'pcb-pulse-trace 2.4s ' + pulseDelay + 's infinite';
      traceG.appendChild(traceEl);
      traceEls[sys.name] = traceEl;

      var vE = svgEl('circle');
      vE.setAttribute('cx', exit.x); vE.setAttribute('cy', exit.y);
      vE.setAttribute('r', '3.5'); vE.setAttribute('fill', '#07101f');
      vE.setAttribute('stroke', cat.color); vE.setAttribute('stroke-width', '1.2');
      traceG.appendChild(vE);

      var vP = svgEl('circle');
      vP.setAttribute('cx', pin.x); vP.setAttribute('cy', pin.y);
      vP.setAttribute('r', '3'); vP.setAttribute('fill', cat.color);
      traceG.appendChild(vP);

      path.bends.forEach(function (b) {
        var vB = svgEl('circle');
        vB.setAttribute('cx', b.x); vB.setAttribute('cy', b.y);
        vB.setAttribute('r', '1.5'); vB.setAttribute('fill', cat.color);
        vB.setAttribute('opacity', '0.35');
        traceG.appendChild(vB);
      });

      var pkt = svgEl('circle');
      pkt.setAttribute('r', '3'); pkt.setAttribute('fill', cat.color);
      var am = svgEl('animateMotion');
      am.setAttribute('dur', '3.6s'); am.setAttribute('begin', delay + 's');
      am.setAttribute('repeatCount', 'indefinite'); am.setAttribute('path', path.d);
      am.setAttribute('rotate', 'auto');
      var ao = svgEl('animate');
      ao.setAttribute('attributeName', 'opacity'); ao.setAttribute('dur', '3.6s');
      ao.setAttribute('begin', delay + 's'); ao.setAttribute('repeatCount', 'indefinite');
      ao.setAttribute('values', '0;0;1;1;0;0'); ao.setAttribute('keyTimes', '0;0.05;0.1;0.9;0.95;1');
      pkt.appendChild(am); pkt.appendChild(ao);
      traceG.appendChild(pkt);

      var pill = document.createElement('div');
      pill.className = 'pcb-pill';
      pill.dataset.cat = sys.cat;
      pill.style.cssText = 'left:' + cx + 'px;top:' + cy + 'px;width:' + pw + 'px;--cat-color:' + cat.color + ';--cat-dim:' + cat.dim;
      var markCls = 'pcb-pill-mark' + (sys.dark ? ' is-dark' : '');
      var fb = sys.name.slice(0, 2).toUpperCase();
      pill.innerHTML =
        '<div class="' + markCls + '">' +
        '<img class="pcb-pill-logo" src="/integraciones/' + sys.logo + '" alt="' + sys.name + '" loading="lazy"' +
        ' onerror="this.outerHTML=\'<span style=&quot;font:800 12px Montserrat;color:#0a1628&quot;>' + fb + '</span>\'">' +
        '</div>' +
        '<div class="pcb-pill-text">' +
        '<div class="pcb-pill-name">' + sys.name + '</div>' +
        '<div class="pcb-pill-sub">' + sys.sub + '</div>' +
        '</div>';

      (function (tr, pl, pd) {
        pill.addEventListener('mouseenter', function () {
          tr.setAttribute('stroke-opacity', '0.9'); tr.setAttribute('stroke-width', '1.6');
          tr.style.animation = 'none';
        });
        pill.addEventListener('mouseleave', function () {
          if (!pl.classList.contains('is-dim')) {
            tr.setAttribute('stroke-opacity', '0.32'); tr.setAttribute('stroke-width', '1.1');
            tr.style.animation = 'pcb-pulse-trace 2.4s ' + pd + 's infinite';
          }
        });
      })(traceEl, pill, pulseDelay);

      pillsEl.appendChild(pill);
      pillEls[sys.name] = pill;
    });

    function filterByCat(cat) {
      SYSTEMS.forEach(function (sys) {
        var p = pillEls[sys.name], tr = traceEls[sys.name];
        if (!p || !tr) return;
        var active = (cat === null || sys.cat === cat);
        if (active) {
          p.classList.remove('is-dim');
          tr.setAttribute('stroke-opacity', '0.32'); tr.setAttribute('stroke-width', '1.1');
        } else {
          p.classList.add('is-dim');
          tr.setAttribute('stroke-opacity', '0.06'); tr.setAttribute('stroke-width', '0.7');
        }
      });
    }

    updateScale();
  })();
</script>
