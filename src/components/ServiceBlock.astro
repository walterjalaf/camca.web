---
import type { Area } from '@data/servicios';
interface Props {
  area: Area;
  index: number;
}
const { area, index } = Astro.props;
const num = String(index + 1).padStart(2, '0');
const reverse = index % 2 === 1;
---
<article id={area.id} class:list={['svc-block reveal', { 'svc-block--reverse': reverse }]}>
  <div class="svc-text">
    <div class="svc-head">
      <span class="svc-num">{num}</span>
      <div>
        <h3 class="svc-title">{area.title}</h3>
        <p class="svc-tagline">{area.tagline}</p>
      </div>
    </div>
    <p class="svc-intro muted">{area.intro}</p>
    <ul class="svc-list">
      {area.items.map((it) => (
        <li>
          <span class="svc-bullet" aria-hidden="true">→</span>
          <span>{it}</span>
        </li>
      ))}
    </ul>
  </div>
  <div class="svc-media">
    <img src={area.image} alt={area.title} loading="lazy" decoding="async" />
  </div>
</article>

<style>
  .svc-block {
    display: grid; grid-template-columns: 1.3fr 1fr; gap: clamp(24px, 4vw, 48px); align-items: center;
    background: linear-gradient(180deg, rgba(46,125,83,0.10), rgba(46,125,83,0)); border: 1px solid var(--line);
    padding: clamp(24px, 4vw, 48px); scroll-margin-top: calc(var(--nav-h) + 24px);
  }
  .svc-block--reverse .svc-media { order: -1; }
  .svc-head { display: flex; gap: var(--space-md); align-items: flex-start; }
  .svc-num { font-family: var(--font-display); font-weight: 800; font-size: clamp(40px, 5vw, 64px); line-height: 0.9; color: var(--gold); }
  .svc-title { font-family: var(--font-display); font-weight: 700; text-transform: uppercase; letter-spacing: 0; font-size: clamp(22px, 2.6vw, 30px); color: #fff; }
  .svc-tagline { font-family: var(--font-mono); font-size: 12px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--brand-2); margin-top: 6px; }
  .svc-intro { margin-top: var(--space-md); max-width: 72ch; }
  .svc-list { margin-top: var(--space-md); display: grid; grid-template-columns: 1fr 1fr; gap: 12px var(--space-md); }
  .svc-list li { display: flex; gap: 10px; align-items: flex-start; font-size: 15px; color: var(--camca-on-navy-80); }
  .svc-bullet { color: var(--camca-on-navy-55); flex-shrink: 0; }

  .svc-media {
    aspect-ratio: 4 / 3; border: 1px solid var(--line-strong); overflow: hidden;
    clip-path: polygon(0 0, calc(100% - 26px) 0, 100% 26px, 100% 100%, 0 100%);
  }
  .svc-media img { width: 100%; height: 100%; object-fit: cover; }

  @media (max-width: 820px) {
    .svc-block { grid-template-columns: 1fr; }
    .svc-block--reverse .svc-media { order: 0; }
    .svc-media { aspect-ratio: 16 / 9; }
  }
  @media (max-width: 720px) { .svc-list { grid-template-columns: 1fr; } }
</style>
