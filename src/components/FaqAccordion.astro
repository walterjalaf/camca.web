---
import type { Faq } from '@data/industrias';
interface Props {
  faqs: Faq[];
}
const { faqs } = Astro.props;
---
<div class="faq reveal">
  {faqs.map((f) => (
    <details class="faq-item">
      <summary class="faq-q">
        <span>{f.q}</span>
        <svg class="faq-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
      </summary>
      <p class="faq-a">{f.a}</p>
    </details>
  ))}
</div>

<style>
  .faq { border-top: 1px solid var(--line); }
  .faq-item { border-bottom: 1px solid var(--line); }
  .faq-q {
    display: flex; justify-content: space-between; align-items: center; gap: var(--space-md);
    padding: var(--space-md) 4px; cursor: pointer; list-style: none;
    font-family: var(--font-display); font-weight: 800; text-transform: uppercase; letter-spacing: -0.01em;
    font-size: clamp(15px, 1.5vw, 19px); color: #fff;
  }
  .faq-q::-webkit-details-marker { display: none; }
  .faq-icon { color: var(--gold); flex-shrink: 0; transition: transform var(--dur-hover) var(--ease-out); }
  .faq-item[open] .faq-icon { transform: rotate(45deg); }
  .faq-a { padding: 0 4px var(--space-md); color: var(--ciaf-on-navy-60); max-width: 80ch; }

  :global(.section--paper) .faq { border-top-color: var(--line-dark); }
  :global(.section--paper) .faq-item { border-bottom-color: var(--line-dark); }
  :global(.section--paper) .faq-q { color: var(--ink); }
  :global(.section--paper) .faq-a { color: rgba(26, 26, 26, 0.62); }

  @media (prefers-reduced-motion: reduce) { .faq-icon { transition: none; } }
</style>
