---
// Grilla de logos de clientes (180×180, fondo navy). Logo real o placeholder tipográfico.
import type { Cliente } from '@data/clientes';
interface Props {
  clientes: Cliente[];
  cols?: number;
}
const { clientes } = Astro.props;
---
<ul class="logo-grid reveal" role="list">
  {clientes.map((c) => (
    <li class="logo-cell">
      {c.logo ? (
        <img src={c.logo} alt={c.name} class="logo-img" width="140" height="100" loading="lazy" decoding="async" />
      ) : (
        <span class="logo-placeholder font-display">{c.name}</span>
      )}
    </li>
  ))}
</ul>

<style>
  .logo-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1px; background: var(--ciaf-on-navy-line);
    border: 1px solid var(--ciaf-on-navy-line);
  }
  .logo-cell {
    aspect-ratio: 1 / 1;
    background: var(--ciaf-navy);
    display: flex; align-items: center; justify-content: center;
    padding: var(--space-md);
    transition: background var(--dur-hover) var(--ease-out);
  }
  .logo-cell:hover { background: var(--ciaf-navy-soft); }
  .logo-img {
    max-width: 100%; max-height: 100px; width: auto; height: auto;
    object-fit: contain;
    /* unifica logos de fondos variados sobre el navy */
    background: var(--ciaf-white);
    padding: 10px; border-radius: var(--radius-sm);
  }
  .logo-placeholder {
    color: var(--ciaf-white); font-weight: 600; font-size: 15px;
    text-align: center; line-height: 1.25;
  }
  @media (max-width: 900px) { .logo-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 560px) { .logo-grid { grid-template-columns: repeat(2, 1fr); } }
</style>
