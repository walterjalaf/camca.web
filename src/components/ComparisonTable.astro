---
interface Props {
  leftTitle: string;
  rightTitle: string;
  rows: [string, string][];
}
const { leftTitle, rightTitle, rows } = Astro.props;
---
<div class="cmp reveal">
  <div class="cmp-col cmp-left">
    <h3 class="cmp-head">{leftTitle}</h3>
    {rows.map(([l]) => <div class="cmp-cell">{l}</div>)}
  </div>
  <div class="cmp-col cmp-right">
    <h3 class="cmp-head">{rightTitle}</h3>
    {rows.map(([, r]) => (
      <div class="cmp-cell">
        <svg class="cmp-check" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5" /></svg>
        <span>{r}</span>
      </div>
    ))}
  </div>
</div>

<style>
  .cmp { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-md); }
  .cmp-col { border: 1px solid var(--line); }
  .cmp-left { background: rgba(255, 255, 255, 0.02); }
  .cmp-right { background: linear-gradient(180deg, rgba(30, 74, 130, 0.30), rgba(14, 31, 51, 0.4)); border-color: var(--line-strong); }
  .cmp-head { font-family: var(--font-mono); font-weight: 400; font-size: 11px; text-transform: uppercase; letter-spacing: var(--tracking-mega); padding: var(--space-sm) var(--space-md); border-bottom: 1px solid var(--line); }
  .cmp-left .cmp-head { color: var(--ciaf-on-navy-55); }
  .cmp-right .cmp-head { color: var(--gold); }
  .cmp-cell { display: flex; gap: 10px; align-items: flex-start; padding: var(--space-sm) var(--space-md); border-top: 1px solid var(--line); font-size: 15px; line-height: 1.45; }
  .cmp-cell:first-of-type { border-top: 0; }
  .cmp-left .cmp-cell { color: var(--ciaf-on-navy-60); }
  .cmp-right .cmp-cell { color: #fff; }
  .cmp-check { color: var(--gold); flex-shrink: 0; margin-top: 2px; }
  @media (max-width: 720px) { .cmp { grid-template-columns: 1fr; } }
</style>
