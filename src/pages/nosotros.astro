---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/PageHero.astro';
import CtaBanner from '@components/CtaBanner.astro';
import { SITE, waLink } from '@data/site';
import { iconSvg } from '@data/icons';

const MISION = 'Brindar soluciones rápidas y responsables en todo tipo de terrenos.';
const VISION = 'Ser el referente indiscutido en la comunidad por el saneamiento ambiental para la industria.';

const RAZONES = [
  { icon: 'clock', title: 'Respuesta inmediata', desc: 'Capacidad de despliegue rápido con flota propia y personal especializado, disponible ante emergencias 24/7.' },
  { icon: 'shield', title: 'Calidad y seguridad', desc: 'Protocolos rigurosos de higiene, equipamiento certificado y mantenimiento preventivo en cada unidad.' },
  { icon: 'mountain', title: 'Alta montaña', desc: 'Flota de camionetas 4x4 equipadas para acceder a zonas remotas y terrenos de difícil acceso.' },
  { icon: 'leaf', title: 'Compromiso ambiental', desc: 'Baños ecológicos y procesos de tratamiento diseñados para minimizar el impacto ambiental.' },
];

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Nosotros', item: `${SITE.url}/nosotros` },
  ],
};
---
<BaseLayout
  title="Nosotros — Saneamiento ambiental en Calingasta | CAMCA"
  description="CAMCA es una empresa de Tamberías, Calingasta, especializada en saneamiento ambiental para minería, construcción y eventos. Conocé nuestra misión, visión y compromiso comunitario."
  path="/nosotros"
  jsonLd={breadcrumb}
>
  <PageHero
    eyebrow="Nosotros"
    title="Una empresa de<br />Tamberías, Calingasta."
    lead="Con más de 15 años de experiencia en la región, desarrollamos una capacidad operativa única para trabajar en condiciones extremas: alta montaña, zonas remotas y proyectos de gran escala."
    ctas={[
      { label: 'Trabajemos juntos', href: waLink('Hola CAMCA, quiero conocerlos y ver cómo pueden ayudarme'), external: true },
      { label: 'Ver servicios', href: '/servicios', variant: 'ghost' },
    ]}
  />

  <!-- Misión / Visión -->
  <section class="section">
    <div class="container">
      <div class="mv-grid">
        <article class="mv-card reveal" data-reveal="left">
          <span class="eyebrow">// Misión</span>
          <p class="mv-text">{MISION}</p>
        </article>
        <article class="mv-card mv-card--brand reveal" data-reveal="right" data-delay="1">
          <span class="eyebrow mv-eyebrow-gold">// Visión</span>
          <p class="mv-text">{VISION}</p>
        </article>
      </div>
    </div>
  </section>

  <!-- Por qué CAMCA -->
  <section class="section">
    <div class="container">
      <span class="ribbon reveal">Por qué CAMCA</span>
      <h2 class="h2 reveal" style="margin-top: var(--space-md); max-width: 22ch;">Lo que nos hace distintos.</h2>
      <div class="grid-hair razones reveal">
        {RAZONES.map((r) => (
          <div class="razon-cell">
            <span class="razon-icon" set:html={iconSvg(r.icon)} />
            <div>
              <h3 class="razon-title">{r.title}</h3>
              <p class="razon-desc">{r.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Banda humana -->
  <section class="section">
    <div class="container human-grid">
      <div
        class="human-media reveal"
        data-reveal="left"
        style="--photo: url('/fotos/nosotros.webp')"
        role="img"
        aria-label="Equipo y flota de CAMCA en operación de alta montaña"
      ></div>
      <div class="human-text reveal" data-reveal="right" data-delay="1">
        <span class="ribbon">Compromiso comunitario</span>
        <h2 class="h2 human-title">Impulsando el crecimiento de nuestra comunidad.</h2>
        <p class="human-body">
          Como empresa de Tamberías, Calingasta, generamos empleo local, participamos en iniciativas de
          desarrollo regional y operamos con respeto por el entorno natural de la cordillera. Contamos con
          una flota de camionetas 4x4 equipadas, baños ecológicos de última generación y un equipo humano
          comprometido con la excelencia en el servicio.
        </p>
      </div>
    </div>
  </section>

  <CtaBanner title="Hablemos de tu proyecto." />
</BaseLayout>

<style>
  .mv-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-md); }
  .mv-card { background: linear-gradient(180deg, rgba(46,125,83,0.10), rgba(46,125,83,0)); border: 1px solid var(--line); padding: clamp(28px, 4vw, 48px); }
  .mv-card--brand { background: linear-gradient(180deg, rgba(46,125,83,0.32), rgba(11,59,36,0.4)); border-color: var(--line-strong); }
  .mv-eyebrow-gold { color: var(--gold); }
  .mv-text { margin-top: var(--space-md); font-size: clamp(16px, 1.4vw, 19px); line-height: 1.6; color: var(--camca-on-navy-80); }
  @media (max-width: 720px) { .mv-grid { grid-template-columns: 1fr; } }

  .razones { margin-top: var(--space-lg); grid-template-columns: repeat(2, 1fr); }
  .razon-cell { padding: clamp(22px, 3vw, 34px); display: flex; flex-direction: column; gap: 16px; }
  .razon-icon { color: #fff; }
  .razon-title { font-family: var(--font-display); font-weight: 800; text-transform: uppercase; letter-spacing: -0.01em; font-size: 17px; color: #fff; }
  .razon-desc { color: var(--camca-on-navy-60); font-size: 14px; margin-top: 4px; }
  @media (max-width: 760px) { .razones { grid-template-columns: 1fr; } }

  /* Banda humana */
  .human-grid { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: clamp(28px, 5vw, 64px); align-items: center; }
  .human-media {
    position: relative; min-height: clamp(240px, 34vw, 400px); border: 1px solid var(--line-strong);
    border-radius: var(--radius-md); overflow: hidden;
    background-image: var(--photo, none), linear-gradient(155deg, rgba(62,154,103,0.55), rgba(11,59,36,0.92));
    background-size: cover; background-position: center; box-shadow: var(--shadow-card);
  }
  .human-media::after {
    content: ""; position: absolute; inset: 0; pointer-events: none;
    background-image: linear-gradient(rgba(255,255,255,0.04) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.04) 1px, transparent 1px);
    background-size: 34px 34px; mix-blend-mode: overlay;
  }
  .human-title { margin-top: var(--space-md); max-width: 18ch; }
  .human-body { margin-top: var(--space-md); color: var(--camca-on-navy-80); font-size: clamp(16px, 1.4vw, 19px); line-height: 1.6; max-width: 52ch; }
  @media (max-width: 820px) { .human-grid { grid-template-columns: 1fr; } .human-media { order: -1; min-height: clamp(200px, 52vw, 300px); } }
</style>
