---
import BaseLayout from '@layouts/BaseLayout.astro';
import SectionHeading from '@components/SectionHeading.astro';
import KpiStat from '@components/KpiStat.astro';
import LogoMarquee from '@components/LogoMarquee.astro';
import Card from '@components/Card.astro';
import CtaBanner from '@components/CtaBanner.astro';
import TopoPattern from '@components/TopoPattern.astro';
import { SITE, STATS, waLink } from '@data/site';
import { AREAS, PROCESO } from '@data/servicios';
import { CLIENTES } from '@data/clientes';
import { INDUSTRIAS_ORDENADAS } from '@data/industrias';

const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url,
  inLanguage: 'es-AR',
};
---
<BaseLayout
  title={`${SITE.name} — Saneamiento ambiental de alta montaña en San Juan`}
  description="Especialistas en saneamiento ambiental para minería, construcción, eventos y operaciones de alta exigencia en Calingasta, San Juan. Baños ecológicos, módulos sanitarios y logística 4x4."
  path="/"
  jsonLd={websiteLd}
>
  <!-- HERO (feature: foto a sangre + silueta de cordillera) -->
  <section class="hero-feature section--flat" aria-label="Portada">
    <div class="hero-feature-photo" style="--photo: url('/fotos/hero-home.webp')" role="img" aria-label="Cordillera de Calingasta, San Juan, zona de operaciones de CAMCA"></div>
    <div class="hero-feature-scrim" aria-hidden="true"></div>
    <TopoPattern class="hero-feature-topo" opacity={0.14} />
    <span class="hero-feature-shape" aria-hidden="true"></span>
    <div class="container hero-feature-inner">
      <p class="eyebrow hero-feature-eyebrow load-in">Servicios Integrales · Tamberías, Calingasta, San Juan</p>
      <h1 class="hero-feature-title load-in" data-delay="1">Soluciones sanitarias de alta montaña.</h1>
      <p class="hero-feature-lead load-in" data-delay="2">
        Especialistas en saneamiento ambiental para minería, construcción, eventos y operaciones de alta
        exigencia en Calingasta, San Juan. Baños ecológicos, módulos sanitarios y logística 4x4 propia
        para llegar donde otros no llegan.
      </p>
      <div class="hero-actions load-in" data-delay="3">
        <a href={waLink('Hola CAMCA, quiero solicitar una cotización')} target="_blank" rel="noopener" class="btn btn--gold btn--lg cta-primary">
          <span>Solicitar cotización</span>
          <span class="cta-arrow" aria-hidden="true">→</span>
        </a>
        <a href="/servicios" class="btn btn--onphoto btn--lg">Ver servicios</a>
      </div>
      <p class="hero-reassure load-in" data-delay="4">
        <span class="reassure-dot" aria-hidden="true"></span>
        Flota 4x4 propia · Respuesta ante emergencias 24/7
      </p>
    </div>
  </section>

  <!-- PRUEBA SOCIAL + KPIs + carrusel de clientes -->
  <section class="section">
    <div class="container">
      <div class="kpi-row">
        {STATS.map((s, i) => <KpiStat value={s.value} label={s.label} gold={i === 0} delay={(i as 0 | 1 | 2 | 3)} />)}
      </div>
      <p class="eyebrow social-label reveal">// Empresas que confían en CAMCA</p>
    </div>
    <div class="clients-band reveal" data-delay="1">
      <LogoMarquee clientes={CLIENTES} />
    </div>
  </section>

  <!-- CÓMO TRABAJAMOS (proceso) -->
  <section class="section proceso" id="como-trabajamos">
    <TopoPattern class="proceso-topo" opacity={0.07} />
    <div class="container proceso-inner">
      <span class="ribbon reveal">Quiénes somos</span>
      <h2 class="h2 proceso-headline reveal" data-delay="1">
        Referentes en saneamiento ambiental para operaciones de <span class="proceso-em">alta exigencia</span>.
      </h2>
      <p class="proceso-sub reveal" data-delay="2">
        CAMCA Servicios Integrales es una empresa de Tamberías, Calingasta, especializada en soluciones
        sanitarias móviles para minería, construcción, eventos masivos y proyectos que requieren
        respuestas rápidas y responsables en terrenos de alta exigencia. Así trabajamos, de la consulta
        al mantenimiento en el terreno.
      </p>
      <ol class="proceso-steps reveal" data-delay="3">
        {PROCESO.map((p, i) => (
          <li class="proceso-step">
            <span class="proceso-num">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="proceso-title">{p.title}</h3>
            <p class="proceso-desc">{p.desc}</p>
          </li>
        ))}
      </ol>

      <div class="proceso-photos reveal" data-delay="4">
        <div class="proceso-photo"><img src="/fotos/servicio-logistica.webp" alt="Flota 4x4 de CAMCA en alta montaña" loading="lazy" decoding="async" /></div>
        <div class="proceso-photo"><img src="/fotos/servicio-desagote.webp" alt="Camión de mantenimiento y desagote de CAMCA" loading="lazy" decoding="async" /></div>
        <div class="proceso-photo"><img src="/fotos/servicio-banos.webp" alt="Baños ecológicos instalados por CAMCA" loading="lazy" decoding="async" /></div>
      </div>

      <a href="/nosotros" class="btn proceso-cta reveal" data-delay="5">Conocé más sobre CAMCA</a>
    </div>
  </section>

  <!-- SERVICIOS -->
  <section class="section" id="servicios">
    <div class="container">
      <SectionHeading eyebrow="Servicios" title="Soluciones integrales de saneamiento ambiental.">
        Adaptadas a las necesidades de cada proyecto: desde el alquiler de una unidad hasta el
        equipamiento completo de un campamento minero.
      </SectionHeading>
      <div class="grid grid-3 svc-areas">
        {AREAS.map((a, i) => (
          <Card title={a.title} href={`/servicios#${a.id}`} eyebrow={`// Servicio 0${i + 1}`} delay={(i % 3) as 0 | 1 | 2}>
            <p>{a.tagline}</p>
          </Card>
        ))}
      </div>
      <div class="svc-cta reveal"><a href="/servicios" class="btn">Ver todos los servicios</a></div>
    </div>
  </section>

  <!-- INDUSTRIAS -->
  <section class="section">
    <div class="container">
      <SectionHeading eyebrow="Industrias" title="Soluciones especializadas por rubro.">
        No damos respuestas genéricas: entendemos las exigencias específicas de cada industria y
        trabajamos sobre ellas.
      </SectionHeading>
      <div class="grid grid-3 ind-grid">
        {INDUSTRIAS_ORDENADAS.map((ind, i) => (
          <Card title={ind.name} href={`/industrias/${ind.slug}`} eyebrow="// Vertical" delay={(i % 3) as 0 | 1 | 2}>
            <p>{ind.hook}</p>
          </Card>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA FINAL -->
  <CtaBanner />
</BaseLayout>

<style>
  /* ===== Hero feature (foto a sangre + velo + silueta de cordillera) ===== */
  .hero-feature {
    position: relative; overflow: hidden; isolation: isolate;
    min-height: clamp(540px, 78vh, 720px);
    display: flex; align-items: center;
    padding-top: calc(var(--nav-h) + clamp(20px, 4vw, 48px));
    padding-bottom: clamp(40px, 6vw, 80px);
    background: var(--ink);
  }
  .hero-feature-photo {
    position: absolute; inset: 0; z-index: 0;
    background-image: var(--photo, none);
    background-size: cover; background-position: center 68%;
  }
  /* Velo verde: legibilidad del texto a la izquierda, foto respira a la derecha */
  .hero-feature-scrim {
    position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background:
      linear-gradient(90deg, rgba(11,59,36,0.97) 0%, rgba(11,59,36,0.90) 34%, rgba(11,59,36,0.55) 66%, rgba(11,59,36,0.32) 100%),
      linear-gradient(0deg, rgba(11,59,36,0.60), rgba(11,59,36,0) 42%);
  }
  .hero-feature-topo { z-index: 1; color: #fff; }
  /* Acento geométrico: silueta de cordillera recortada, no un simple paralelogramo */
  .hero-feature-shape {
    position: absolute; z-index: 2; pointer-events: none; display: none;
    right: -2vw; top: 0; bottom: 0; width: clamp(180px, 20vw, 320px);
    background: linear-gradient(165deg, var(--gold), #8a5236);
    clip-path: polygon(38% 0%, 62% 0%, 100% 22%, 100% 100%, 0% 100%, 0% 46%, 22% 30%);
    opacity: 0.96; box-shadow: -18px 0 60px rgba(0,0,0,0.35);
  }
  @media (min-width: 1024px) { .hero-feature-shape { display: block; } }

  .hero-feature-inner { position: relative; z-index: 3; max-width: 980px; }
  .hero-feature-eyebrow { color: var(--gold); }
  .hero-feature-title {
    margin-top: var(--space-sm); max-width: 17ch;
    font-family: var(--font-display); font-weight: 800; color: #fff;
    font-size: clamp(40px, 6.4vw, 82px); line-height: 0.98; letter-spacing: -0.01em;
  }
  .hero-feature-lead {
    margin-top: var(--space-md); max-width: 56ch; color: rgba(255,255,255,0.90);
    font-size: clamp(17px, 1.5vw, 21px); line-height: 1.55;
    text-shadow: 0 1px 18px rgba(11,59,36,0.5);
  }
  .hero-actions { display: flex; flex-wrap: wrap; gap: var(--space-sm); margin-top: var(--space-lg); }

  .btn--lg { min-height: 56px; padding: 1.05rem 1.7rem; font-size: 13px; letter-spacing: 0.09em; }
  .cta-primary { gap: 0.7rem; }
  .cta-arrow { display: inline-block; font-weight: 800; transition: transform var(--dur-hover) var(--ease-out); }
  .cta-primary:hover .cta-arrow { transform: translateX(5px); }

  .btn--gold {
    background: var(--gold); border-color: var(--gold); color: #fff; font-weight: 800;
    box-shadow: 0 14px 34px rgba(201,125,74,0.40), 0 6px 16px rgba(0,0,0,0.34);
  }
  .btn--gold:hover {
    background: #d68f5f; border-color: #d68f5f; color: #fff; transform: translateY(-2px);
    box-shadow: 0 20px 44px rgba(201,125,74,0.50), 0 10px 22px rgba(0,0,0,0.4);
  }
  .btn--gold:active { transform: translateY(0); }
  .btn--onphoto { border-color: rgba(255,255,255,0.8); color: #fff; background: rgba(255,255,255,0.10); }
  .btn--onphoto:hover { background: #fff; color: var(--ink); border-color: #fff; transform: translateY(-2px); }

  .hero-reassure {
    margin-top: var(--space-md); display: inline-flex; align-items: center; gap: 10px;
    font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.03em;
    color: rgba(255,255,255,0.85); text-shadow: 0 1px 12px rgba(11,59,36,0.6);
  }
  .reassure-dot {
    width: 8px; height: 8px; border-radius: 50%; background: var(--gold); flex-shrink: 0;
    box-shadow: 0 0 0 4px rgba(201,125,74,0.22);
  }

  @media (prefers-reduced-motion: reduce) {
    .btn--gold:hover, .btn--onphoto:hover { transform: none; }
    .cta-primary:hover .cta-arrow { transform: none; }
  }
  @media (max-width: 560px) {
    .hero-feature { min-height: clamp(480px, 86vh, 600px); }
    .hero-actions .btn { flex: 1 1 auto; }
  }

  /* KPIs + social */
  .kpi-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-md); }
  .social-label { margin: var(--space-xl) 0 var(--space-md); }
  @media (max-width: 720px) { .kpi-row { grid-template-columns: repeat(2, 1fr); gap: var(--space-lg) var(--space-md); } }

  /* Banda de clientes */
  .clients-band {
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.04), rgba(255, 255, 255, 0.015));
    border-block: 1px solid var(--line); padding-block: clamp(26px, 4vw, 44px);
  }

  /* Cómo trabajamos */
  .proceso { position: relative; overflow: hidden; }
  .proceso-topo { color: #fff; }
  .proceso-inner { position: relative; max-width: 1100px; }
  .proceso-headline {
    margin-top: var(--space-md); max-width: 26ch; font-size: clamp(27px, 4.2vw, 50px);
  }
  .proceso-em { color: var(--gold); }
  .proceso-sub { margin-top: var(--space-md); color: var(--camca-on-navy-80); font-size: clamp(16px, 1.4vw, 19px); line-height: 1.6; max-width: 68ch; }

  .proceso-steps {
    margin-top: var(--space-xl); display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-md);
    counter-reset: step; position: relative;
  }
  .proceso-steps::before {
    content: ""; position: absolute; top: 27px; left: 4%; right: 4%; height: 1px;
    background: linear-gradient(90deg, transparent, var(--line-strong) 8%, var(--line-strong) 92%, transparent);
  }
  .proceso-step { position: relative; padding-top: var(--space-lg); }
  .proceso-num {
    position: absolute; top: 0; left: 0; font-family: var(--font-display); font-weight: 800;
    font-size: 34px; line-height: 1; color: var(--gold); background: var(--ink); padding-right: 10px;
  }
  .proceso-title { font-family: var(--font-display); font-weight: 700; text-transform: uppercase; letter-spacing: -0.005em; font-size: 20px; color: #fff; }
  .proceso-desc { margin-top: 8px; color: var(--camca-on-navy-60); font-size: 14.5px; line-height: 1.5; }

  .proceso-photos { margin-top: var(--space-xl); display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-md); }
  .proceso-photo {
    aspect-ratio: 4 / 3; border: 1px solid var(--line-strong); overflow: hidden;
    clip-path: polygon(0 0, calc(100% - 20px) 0, 100% 20px, 100% 100%, 0 100%);
  }
  .proceso-photo img { width: 100%; height: 100%; object-fit: cover; transition: transform var(--dur-hover) var(--ease-out); }
  .proceso-photo:hover img { transform: scale(1.05); }

  .proceso-cta { margin-top: var(--space-xl); }

  @media (max-width: 860px) {
    .proceso-steps { grid-template-columns: 1fr 1fr; gap: var(--space-lg) var(--space-md); }
    .proceso-steps::before { display: none; }
  }
  @media (max-width: 620px) { .proceso-photos { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { .proceso-steps { grid-template-columns: 1fr; } }

  .svc-areas { margin-top: var(--space-lg); }
  .svc-cta { margin-top: var(--space-lg); }

  .ind-grid { margin-top: var(--space-lg); }
</style>
