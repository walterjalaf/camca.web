---
import BaseLayout from '@layouts/BaseLayout.astro';
import SectionHeading from '@components/SectionHeading.astro';
import KpiStat from '@components/KpiStat.astro';
import LogoMarquee from '@components/LogoMarquee.astro';
import Card from '@components/Card.astro';
import StackSection from '@components/StackSection.astro';
import CtaBanner from '@components/CtaBanner.astro';
import { SITE, STATS, waLink } from '@data/site';
import { AREAS, OUTSOURCING_BENEFITS } from '@data/servicios';
import { CLIENTES } from '@data/clientes';
import { INDUSTRIAS_ORDENADAS } from '@data/industrias';

const diffPoints = [
  'Genera la información desde adentro, no la recibe a fin de mes',
  'Actúa en tiempo real sobre la operación, no después del cierre',
  'Gestión, reportes y cumplimiento — no solo declaraciones',
  'Una consultora comprometida con tu operación, no un servicio por tarea',
];

const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url,
  inLanguage: 'es-AR',
};
---
<BaseLayout
  title={`${SITE.name} — Outsourcing administrativo y contable en San Juan`}
  description="Somos el equipo administrativo, contable, impositivo y financiero externo de más de 30 empresas de San Juan. Vos hacés crecer tu negocio; de los números nos ocupamos nosotros."
  path="/"
  jsonLd={websiteLd}
>
  <!-- HERO (feature: foto a sangre + acento de marca, registro editorial corporativo) -->
  <section class="hero-feature section--flat" aria-label="Portada">
    <div class="hero-feature-photo" style="--photo: url('/fotos/hero-home.webp')" role="img" aria-label="Equipo de CIAF trabajando junto a sus clientes"></div>
    <div class="hero-feature-scrim" aria-hidden="true"></div>
    <span class="hero-feature-shape" aria-hidden="true"></span>
    <div class="container hero-feature-inner">
      <p class="eyebrow hero-feature-eyebrow load-in">Consultora Integral · San Juan, Argentina</p>
      <h1 class="hero-feature-title load-in" data-delay="1">Tu socio estratégico en administración y finanzas.</h1>
      <p class="hero-feature-lead load-in" data-delay="2">
        Más que una consultora: nos integramos a tu operación como un equipo propio. Acompañamos a más
        de 30 empresas de San Juan en administración, contabilidad, impuestos y finanzas — para que
        tomes mejores decisiones y crezcas tranquilo.
      </p>
      <div class="hero-actions load-in" data-delay="3">
        <a href={waLink('Hola CIAF, quiero agendar una reunión')} target="_blank" rel="noopener" class="btn btn--gold btn--lg cta-primary">
          <span>Agendá una reunión</span>
          <span class="cta-arrow" aria-hidden="true">→</span>
        </a>
        <a href="/servicios" class="btn btn--onphoto btn--lg">Ver servicios</a>
      </div>
      <p class="hero-reassure load-in" data-delay="4">
        <span class="reassure-dot" aria-hidden="true"></span>
        Primera reunión sin costo · Te respondemos en el día
      </p>
    </div>
  </section>

  <!-- PRUEBA SOCIAL + KPIs + carrusel de clientes -->
  <section class="section">
    <div class="container">
      <div class="kpi-row">
        {STATS.map((s, i) => <KpiStat value={s.value} label={s.label} gold={i === 0} delay={(i as 0 | 1 | 2 | 3)} />)}
      </div>
      <p class="eyebrow social-label reveal">// Empresas que confían en CIAF</p>
    </div>
    <div class="clients-band reveal" data-delay="1">
      <LogoMarquee clientes={CLIENTES} />
    </div>
  </section>

  <!-- EL DIFERENCIAL (narrativa) -->
  <section class="section diff" id="diferencial">
    <div class="container diff-inner">
      <span class="ribbon reveal">El diferencial</span>
      <blockquote class="diff-quote reveal" data-delay="1">
        “Un estudio contable recibe tus papeles y te devuelve declaraciones.”
      </blockquote>
      <h2 class="diff-headline reveal" data-delay="1">
        Y a fin de mes seguís sin saber si tu negocio <span class="diff-em">ganó o perdió plata</span>.
      </h2>
      <p class="diff-sub reveal" data-delay="2">
        No esperamos al cierre del mes: trabajamos en tu día a día, con tu gente y tus sistemas, para que
        decidas con números que reflejan lo que está pasando ahora en tu negocio.
      </p>
      <ul class="diff-points reveal" data-delay="3">
        {diffPoints.map((p) => (
          <li><span class="diff-check" aria-hidden="true">→</span><span>{p}</span></li>
        ))}
      </ul>
      <a href="/servicios" class="btn diff-cta reveal" data-delay="4">Ver cómo trabajamos</a>
    </div>
  </section>

  <!-- SERVICIOS -->
  <section class="section">
    <div class="container">
      <div class="svc-star reveal">
        <div class="svc-star-head">
          <span class="ribbon">Servicio estrella</span>
          <h2 class="h2 svc-star-title">Outsourcing<br />Administrativo</h2>
          <p class="svc-star-desc">
            No es tercerizar tareas: es sumar un equipo a tu operación. Liquidamos, conciliamos,
            presentamos y reportamos — y te damos la información para decidir tranquilo.
          </p>
        </div>
        <ul class="svc-benefits">
          {OUTSOURCING_BENEFITS.map((b) => (
            <li><span class="svc-check" aria-hidden="true">→</span><span>{b}</span></li>
          ))}
        </ul>
      </div>

      <div class="grid grid-2 svc-areas">
        {AREAS.map((a, i) => (
          <Card title={a.title} href={`/servicios#${a.id}`} eyebrow={`// Área 0${i + 1}`} delay={(i % 3) as 0 | 1 | 2}>
            <p>{a.tagline}</p>
          </Card>
        ))}
      </div>
      <div class="svc-cta reveal"><a href="/servicios" class="btn">Ver todos los servicios</a></div>
    </div>
  </section>

  <!-- INDUSTRIAS -->
  <section class="section">
    <div class="container">
      <SectionHeading eyebrow="Industrias" title="Conocemos tu industria por dentro.">
        No damos soluciones genéricas: entendemos los dolores específicos de cada rubro y trabajamos sobre ellos.
      </SectionHeading>
      <div class="grid grid-3 ind-grid">
        {INDUSTRIAS_ORDENADAS.map((ind, i) => (
          <Card title={ind.name} href={`/industrias/${ind.slug}`} eyebrow="// Vertical" delay={(i % 3) as 0 | 1 | 2}>
            <p>{ind.hook}</p>
          </Card>
        ))}
      </div>
    </div>
  </section>

  <!-- STACK / 12 (PCB, tal cual del brochure) -->
  <StackSection />

  <!-- CTA FINAL -->
  <CtaBanner />
</BaseLayout>

<style>
  /* ===== Hero feature (foto a sangre + velo + acento de marca) ===== */
  .hero-feature {
    position: relative; overflow: hidden; isolation: isolate;
    min-height: clamp(540px, 78vh, 720px);
    display: flex; align-items: center;
    padding-top: calc(var(--nav-h) + clamp(20px, 4vw, 48px));
    padding-bottom: clamp(40px, 6vw, 80px);
    background: var(--ink);
  }
  .hero-feature-photo {
    position: absolute; inset: 0; z-index: 0;
    background-image: var(--photo, none);
    background-size: cover; background-position: 70% center;
  }
  /* Velo navy: legibilidad del texto a la izquierda, foto respira a la derecha */
  .hero-feature-scrim {
    position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background:
      linear-gradient(90deg, rgba(14,31,51,0.97) 0%, rgba(14,31,51,0.90) 34%, rgba(14,31,51,0.55) 66%, rgba(14,31,51,0.32) 100%),
      linear-gradient(0deg, rgba(14,31,51,0.60), rgba(14,31,51,0) 42%);
  }
  /* Acento geométrico dorado (sello de marca, guiño al lenguaje corporativo) */
  .hero-feature-shape {
    position: absolute; z-index: 2; pointer-events: none; display: none;
    right: -3vw; top: 0; bottom: 0; width: clamp(140px, 16vw, 240px);
    background: linear-gradient(180deg, var(--gold), #d98e12);
    transform: skewX(-12deg); transform-origin: top;
    opacity: 0.96; box-shadow: -18px 0 60px rgba(0,0,0,0.35);
  }
  @media (min-width: 1024px) { .hero-feature-shape { display: block; } }

  .hero-feature-inner { position: relative; z-index: 3; max-width: 980px; }
  .hero-feature-eyebrow { color: var(--gold); }
  /* Editorial: sentence case (no mayúsculas gritadas), grande y firme */
  .hero-feature-title {
    margin-top: var(--space-sm); max-width: 17ch;
    font-family: var(--font-display); font-weight: 800; color: #fff;
    font-size: clamp(34px, 5.4vw, 68px); line-height: 1.03; letter-spacing: -0.022em;
  }
  .hero-feature-lead {
    margin-top: var(--space-md); max-width: 52ch; color: rgba(255,255,255,0.90);
    font-size: clamp(17px, 1.5vw, 21px); line-height: 1.55;
    text-shadow: 0 1px 18px rgba(14,31,51,0.5);
  }
  .hero-actions { display: flex; flex-wrap: wrap; gap: var(--space-sm); margin-top: var(--space-lg); }

  /* Botones de acción con más impacto */
  .btn--lg { min-height: 56px; padding: 1.05rem 1.7rem; font-size: 13px; letter-spacing: 0.09em; }
  .cta-primary { gap: 0.7rem; }
  .cta-arrow { display: inline-block; font-weight: 800; transition: transform var(--dur-hover) var(--ease-out); }
  .cta-primary:hover .cta-arrow { transform: translateX(5px); }

  /* Dorado: alto contraste + halo dorado para que “salte” sobre la foto */
  .btn--gold {
    background: var(--gold); border-color: var(--gold); color: var(--ink); font-weight: 800;
    box-shadow: 0 14px 34px rgba(245,166,35,0.40), 0 6px 16px rgba(0,0,0,0.34);
  }
  .btn--gold:hover {
    background: #ffb83d; border-color: #ffb83d; color: var(--ink); transform: translateY(-2px);
    box-shadow: 0 20px 44px rgba(245,166,35,0.50), 0 10px 22px rgba(0,0,0,0.4);
  }
  .btn--gold:active { transform: translateY(0); }
  .btn--onphoto { border-color: rgba(255,255,255,0.8); color: #fff; background: rgba(255,255,255,0.10); }
  .btn--onphoto:hover { background: #fff; color: var(--ink); border-color: #fff; transform: translateY(-2px); }

  /* Reaseguro bajo los CTAs: baja la fricción de agendar */
  .hero-reassure {
    margin-top: var(--space-md); display: inline-flex; align-items: center; gap: 10px;
    font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.03em;
    color: rgba(255,255,255,0.85); text-shadow: 0 1px 12px rgba(14,31,51,0.6);
  }
  .reassure-dot {
    width: 8px; height: 8px; border-radius: 50%; background: var(--gold); flex-shrink: 0;
    box-shadow: 0 0 0 4px rgba(245,166,35,0.22);
  }

  @media (prefers-reduced-motion: reduce) {
    .btn--gold:hover, .btn--onphoto:hover { transform: none; }
    .cta-primary:hover .cta-arrow { transform: none; }
  }
  @media (max-width: 560px) {
    .hero-feature { min-height: clamp(480px, 86vh, 600px); }
    .hero-actions .btn { flex: 1 1 auto; }
  }

  /* KPIs + social */
  .kpi-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-md); }
  .social-label { margin: var(--space-xl) 0 var(--space-md); }
  @media (max-width: 720px) { .kpi-row { grid-template-columns: repeat(2, 1fr); gap: var(--space-lg) var(--space-md); } }

  /* Banda de clientes (fondo elevado + carrusel) */
  .clients-band {
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.04), rgba(255, 255, 255, 0.015));
    border-block: 1px solid var(--line); padding-block: clamp(26px, 4vw, 44px);
  }

  /* El diferencial */
  .diff-inner { max-width: 960px; }
  .diff-quote {
    margin-top: var(--space-md); padding-left: var(--space-md); border-left: 3px solid var(--gold);
    font-size: clamp(19px, 2.4vw, 28px); line-height: 1.4; font-style: italic; color: var(--ciaf-on-navy-60);
  }
  .diff-headline {
    margin-top: var(--space-md); font-family: var(--font-display); font-weight: 800;
    font-size: clamp(27px, 4.2vw, 50px); line-height: 1.08; letter-spacing: -0.01em; color: #fff; max-width: 20ch;
  }
  .diff-em { color: var(--gold); font-style: italic; }
  .diff-sub { margin-top: var(--space-md); color: var(--ciaf-on-navy-80); font-size: clamp(16px, 1.4vw, 19px); line-height: 1.6; max-width: 62ch; }
  .diff-points { margin-top: var(--space-lg); display: grid; grid-template-columns: 1fr 1fr; gap: 14px var(--space-lg); }
  .diff-points li { display: flex; gap: 12px; align-items: flex-start; font-size: 16px; font-weight: 600; color: #fff; }
  .diff-check { color: var(--gold); flex-shrink: 0; }
  .diff-cta { margin-top: var(--space-lg); }
  @media (max-width: 680px) { .diff-points { grid-template-columns: 1fr; } }

  /* Servicios */
  .svc-star { display: grid; grid-template-columns: 1.2fr 1fr; gap: var(--space-lg); align-items: center; padding-bottom: var(--space-lg); border-bottom: 1px solid var(--line); }
  .svc-star-title { margin-top: var(--space-md); }
  .svc-star-desc { margin-top: var(--space-md); color: var(--ciaf-on-navy-80); max-width: 52ch; }
  .svc-benefits { display: grid; gap: 14px; }
  .svc-benefits li { display: flex; gap: 12px; align-items: center; font-size: 17px; font-weight: 600; }
  .svc-check { color: var(--gold); flex-shrink: 0; }
  .svc-areas { margin-top: var(--space-lg); }
  .svc-cta { margin-top: var(--space-lg); }
  @media (max-width: 820px) { .svc-star { grid-template-columns: 1fr; gap: var(--space-md); } }

  .ind-grid { margin-top: var(--space-lg); }
</style>
