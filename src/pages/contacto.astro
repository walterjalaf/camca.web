---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/PageHero.astro';
import { SITE, CONTACT, waLink } from '@data/site';

const { lat, lng } = CONTACT.geo;
const d = 0.006;
const bbox = `${lng - d}%2C${lat - d}%2C${lng + d}%2C${lat + d}`;
const osmEmbed = `https://www.openstreetmap.org/export/embed.html?bbox=${bbox}&layer=mapnik&marker=${lat}%2C${lng}`;
const gmaps = `https://www.google.com/maps/search/?api=1&query=${lat}%2C${lng}`;

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Contacto', item: `${SITE.url}/contacto` },
  ],
};
---
<BaseLayout
  title="Contacto — Consultora en San Juan | CIAF"
  description="Contactá a CIAF Consultora Integral en San Juan. WhatsApp, email y formulario. Primera reunión sin costo para conocer tu operación."
  path="/contacto"
  jsonLd={breadcrumb}
>
  <PageHero
    eyebrow="Contacto"
    title="Hablemos de tu<br />próximo paso."
    lead="Contanos qué necesita tu operación y armamos una propuesta a medida. La primera reunión es sin costo."
    ctas={[
      { label: 'Escribir por WhatsApp', href: waLink('Hola CIAF, quiero hacer una consulta'), external: true },
      { label: 'Llamar ahora', href: `tel:${CONTACT.phoneTel}`, variant: 'ghost' },
    ]}
  />

  <section class="section">
    <div class="container contact-grid">
      <!-- Formulario -->
      <div class="form-col reveal">
        <span class="eyebrow">// Escribinos</span>
        <form name="contacto" method="POST" data-netlify="true" netlify-honeypot="bot-field" id="contact-form" class="contact-form" aria-describedby="form-status">
          <input type="hidden" name="form-name" value="contacto" />
          <p class="hp-field" aria-hidden="true"><label>No completar: <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>

          <div class="field">
            <label for="nombre">Nombre *</label>
            <input id="nombre" name="nombre" type="text" required autocomplete="name" />
          </div>
          <div class="field">
            <label for="empresa">Empresa *</label>
            <input id="empresa" name="empresa" type="text" required autocomplete="organization" />
          </div>
          <div class="field-row">
            <div class="field">
              <label for="email">Email *</label>
              <input id="email" name="email" type="email" required autocomplete="email" />
            </div>
            <div class="field">
              <label for="telefono">Teléfono <span class="opt">(opcional)</span></label>
              <input id="telefono" name="telefono" type="tel" autocomplete="tel" />
            </div>
          </div>
          <div class="field">
            <label for="mensaje">Mensaje *</label>
            <textarea id="mensaje" name="mensaje" rows="5" required></textarea>
          </div>
          <button type="submit" class="btn btn--solid form-submit">Enviar mensaje</button>
          <p class="form-status" id="form-status" role="status" aria-live="polite"></p>
        </form>
      </div>

      <!-- Datos -->
      <aside class="data-col reveal" data-delay="1">
        <a href={waLink('Hola CIAF, quiero hacer una consulta')} target="_blank" rel="noopener" class="btn btn--brand wa-btn">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" /></svg>
          Escribir por WhatsApp
        </a>

        <ul class="data-list">
          {CONTACT.emails.map((e) => (
            <li><span class="data-label">{e.label}</span><a href={`mailto:${e.address}`}>{e.address}</a></li>
          ))}
          <li><span class="data-label">Teléfono</span><a href={`tel:${CONTACT.phoneTel}`}>{CONTACT.phoneDisplay}</a></li>
          <li><span class="data-label">Dirección</span><address>{CONTACT.address}<br />{CONTACT.city}, {CONTACT.country}</address></li>
          <li><span class="data-label">Redes</span><span class="data-social">
            <a href={CONTACT.social.instagram.url} target="_blank" rel="noopener">Instagram</a>
            <a href={CONTACT.social.linkedin.url} target="_blank" rel="noopener">LinkedIn</a>
          </span></li>
        </ul>

        <div class="map-wrap">
          <iframe title="Ubicación de CIAF en San Juan" src={osmEmbed} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
          <a href={gmaps} target="_blank" rel="noopener" class="map-link">Ver en Google Maps →</a>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-grid { display: grid; grid-template-columns: 1.2fr 1fr; gap: var(--space-xl); }
  .contact-form { display: grid; gap: var(--space-sm); margin-top: var(--space-md); }
  .hp-field { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .field { display: grid; gap: 6px; }
  .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-sm); }
  label { font-family: var(--font-display); font-weight: 600; font-size: 12px; text-transform: uppercase; letter-spacing: 0.04em; color: var(--ciaf-on-navy-80); cursor: pointer; transition: color var(--dur-hover); }
  .field:focus-within label { color: #fff; }
  .opt { color: var(--ciaf-on-navy-55); font-weight: 400; text-transform: none; }
  input, textarea {
    font: inherit; font-size: 16px; color: #fff;
    padding: 12px 14px; border: 1px solid var(--line-strong); border-radius: var(--radius-sm);
    background: rgba(255,255,255,0.03); transition: border-color var(--dur-hover);
  }
  input::placeholder, textarea::placeholder { color: var(--ciaf-on-navy-55); }
  input:focus, textarea:focus { border-color: var(--brand-2); outline: none; }
  textarea { resize: vertical; }
  .form-submit { margin-top: 6px; justify-content: center; }
  .form-status { font-size: 15px; margin-top: 4px; }
  .form-status.ok { color: #5EE3A0; font-weight: 600; }
  .form-status.err { color: #ff8a80; }

  .data-col { display: flex; flex-direction: column; gap: var(--space-md); }
  .wa-btn { justify-content: center; }
  .data-list { display: grid; gap: var(--space-sm); }
  .data-list li { display: grid; gap: 3px; padding-bottom: var(--space-sm); border-bottom: 1px solid var(--line); }
  .data-label { font-family: var(--font-mono); font-size: 10px; text-transform: uppercase; letter-spacing: var(--tracking-mega); color: var(--ciaf-on-navy-55); }
  .data-list a { color: #fff; font-weight: 600; }
  .data-list a:hover { color: var(--brand-2); }
  .data-list address { font-style: normal; color: var(--ciaf-on-navy-80); }
  .data-social { display: flex; gap: var(--space-md); }

  .map-wrap { margin-top: 4px; }
  .map-wrap iframe { width: 100%; height: 220px; border: 1px solid var(--line); border-radius: var(--radius-md); filter: grayscale(0.3) brightness(0.92); }
  .map-link { display: inline-block; margin-top: 8px; font-family: var(--font-mono); font-size: 12px; color: var(--brand-2); }

  @media (max-width: 860px) { .contact-grid { grid-template-columns: 1fr; gap: var(--space-lg); } }
  @media (max-width: 480px) { .field-row { grid-template-columns: 1fr; } }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status');
  if (form && status) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const submit = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
      if (submit) { submit.disabled = true; submit.textContent = 'Enviando…'; }
      status.className = 'form-status';
      status.textContent = '';
      try {
        const data = new FormData(form);
        await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams(data as any).toString(),
        });
        form.reset();
        status.className = 'form-status ok';
        status.textContent = '¡Gracias! Recibimos tu mensaje y te respondemos a la brevedad.';
      } catch {
        status.className = 'form-status err';
        status.textContent = 'No pudimos enviar el mensaje. Escribinos por WhatsApp o email, por favor.';
      } finally {
        if (submit) { submit.disabled = false; submit.textContent = 'Enviar mensaje'; }
      }
    });
  }
</script>
