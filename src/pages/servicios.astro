---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/PageHero.astro';
import ServiceBlock from '@components/ServiceBlock.astro';
import CtaBanner from '@components/CtaBanner.astro';
import { SITE, waLink } from '@data/site';
import { AREAS, BENEFICIOS } from '@data/servicios';

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Servicios', item: `${SITE.url}/servicios` },
  ],
};
const service = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Saneamiento ambiental y servicios sanitarios móviles',
  provider: { '@id': `${SITE.url}/#organization` },
  areaServed: [{ '@type': 'AdministrativeArea', name: 'San Juan' }, { '@type': 'Country', name: 'Argentina' }],
  description: 'Baños ecológicos, módulos sanitarios y habitacionales, garitas, mantenimiento y logística 4x4 para operaciones de alta exigencia.',
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Servicios',
    itemListElement: AREAS.map((a) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: a.title, description: a.intro },
    })),
  },
};

const gallery = [
  { src: '/fotos/servicio-banos.webp', alt: 'Baños ecológicos CAMCA', label: 'Baños Ecológicos' },
  { src: '/fotos/servicio-modulos.webp', alt: 'Módulos sanitarios CAMCA', label: 'Módulos Sanitarios' },
  { src: '/fotos/servicio-modulos-habitacionales.webp', alt: 'Módulo habitacional CAMCA', label: 'Módulos Habitacionales' },
  { src: '/fotos/servicio-garitas.webp', alt: 'Garita de seguridad CAMCA', label: 'Garitas' },
  { src: '/fotos/servicio-desagote.webp', alt: 'Camión de desagote CAMCA', label: 'Mantenimiento y Desagote' },
  { src: '/fotos/camion-camca.webp', alt: 'Camión cisterna CAMCA para desagote de biodigestores', label: 'Desagote de Biodigestores' },
];
---
<BaseLayout
  title="Servicios de saneamiento ambiental y sanitarios móviles | CAMCA"
  description="Baños ecológicos, módulos sanitarios y habitacionales, garitas, mantenimiento y logística 4x4 de alta montaña. Conocé los servicios de CAMCA en Calingasta, San Juan."
  path="/servicios"
  jsonLd={[breadcrumb, service]}
>
  <PageHero
    eyebrow="Servicios"
    title="Soluciones sanitarias<br />para todo tipo de terreno."
    lead="Desde el alquiler de un baño ecológico hasta el equipamiento sanitario completo de un campamento minero: cubrimos cada etapa con logística propia y flota 4x4 de alta montaña."
    ctas={[
      { label: 'Solicitar cotización', href: waLink('Hola CAMCA, quiero ver qué servicios necesito'), external: true },
      { label: 'Ver industrias', href: '/industrias/mineria', variant: 'ghost' },
    ]}
  />

  <!-- Beneficios -->
  <section class="section">
    <div class="container">
      <div class="outs reveal">
        <div class="outs-text">
          <span class="ribbon">Por qué elegir CAMCA</span>
          <h2 class="h2 outs-title">Un servicio,<br />sin sorpresas.</h2>
          <p class="lead">
            No solo alquilamos equipamiento: nos ocupamos de la instalación, el mantenimiento y la
            logística — con flota propia preparada para alta montaña.
          </p>
        </div>
        <ul class="outs-benefits">
          {BENEFICIOS.map((b) => (
            <li><span class="outs-check" aria-hidden="true">→</span><span>{b}</span></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Galería -->
  <section class="section section--flat">
    <div class="container">
      <div class="gallery reveal">
        {gallery.map((g) => (
          <figure class="gallery-item" style={`--photo:url('${g.src}')`}>
            <img src={g.src} alt={g.alt} loading="lazy" decoding="async" />
            <figcaption>{g.label}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- Las áreas de servicio -->
  <section class="section">
    <div class="container">
      <p class="eyebrow reveal">// Ocho servicios, un solo equipo</p>
      <div class="areas-stack">
        {AREAS.map((a, i) => <ServiceBlock area={a} index={i} />)}
      </div>
    </div>
  </section>

  <CtaBanner title="¿Listos para resolver el saneamiento de tu proyecto?" />
</BaseLayout>

<style>
  .outs { display: grid; grid-template-columns: 1.3fr 1fr; gap: var(--space-lg); align-items: center; }
  .outs-title { margin-top: var(--space-md); }
  .outs-text .lead { margin-top: var(--space-md); max-width: 54ch; }
  .outs-benefits { display: grid; gap: 14px; }
  .outs-benefits li { display: flex; gap: 12px; align-items: center; font-size: 17px; font-weight: 600; }
  .outs-check { color: var(--gold); flex-shrink: 0; }
  @media (max-width: 820px) { .outs { grid-template-columns: 1fr; gap: var(--space-md); } }

  /* 6 fotos: 3x2 en desktop, 2x3 en tablet, 1 columna en móvil — siempre filas completas */
  .gallery { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-md); }
  .gallery-item { position: relative; border-radius: var(--radius-md); overflow: hidden; border: 1px solid var(--line-strong); aspect-ratio: 4/3; }
  .gallery-item img { width: 100%; height: 100%; object-fit: cover; }
  .gallery-item figcaption {
    position: absolute; inset-inline: 0; bottom: 0; padding: var(--space-sm) var(--space-md);
    background: linear-gradient(0deg, rgba(11,59,36,0.88), rgba(11,59,36,0));
    font-family: var(--font-display); font-weight: 800; text-transform: uppercase; letter-spacing: 0.02em;
    font-size: 14px; color: #fff;
  }
  @media (max-width: 860px) { .gallery { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .gallery { grid-template-columns: 1fr; } }

  .areas-stack { margin-top: var(--space-md); display: grid; gap: var(--space-md); }
</style>
