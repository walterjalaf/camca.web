---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/PageHero.astro';
import ServiceBlock from '@components/ServiceBlock.astro';
import CtaBanner from '@components/CtaBanner.astro';
import { SITE, waLink } from '@data/site';
import { AREAS, OUTSOURCING_BENEFITS, COMPLEMENTARIOS } from '@data/servicios';

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Servicios', item: `${SITE.url}/servicios` },
  ],
};
const service = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Outsourcing administrativo, contable, impositivo y financiero',
  provider: { '@id': `${SITE.url}/#organization` },
  areaServed: [{ '@type': 'City', name: 'San Juan' }, { '@type': 'Country', name: 'Argentina' }],
  description: 'Administración, contabilidad, impuestos y finanzas como un departamento externo embebido en tu operación.',
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Áreas de servicio',
    itemListElement: AREAS.map((a) => ({
      '@type': 'OfferCatalog',
      name: a.title,
      itemListElement: a.items.map((i) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: i } })),
    })),
  },
};
---
<BaseLayout
  title="Servicios de outsourcing administrativo y contable | CIAF"
  description="Administración, contabilidad, impuestos y finanzas como un departamento externo embebido en tu operación. Conocé los servicios de CIAF en San Juan."
  path="/servicios"
  jsonLd={[breadcrumb, service]}
>
  <PageHero
    eyebrow="Servicios"
    title="Toda tu administración,<br />en un solo equipo."
    lead="Cubrimos tu operación de punta a punta: desde el back-office del día a día y la planificación fiscal y financiera, hasta el desarrollo de software a medida y la implementación de IA — embebidos en tu negocio, como un área propia."
    ctas={[
      { label: 'Agendar una reunión', href: waLink('Hola CIAF, quiero ver qué servicios necesita mi empresa'), external: true },
      { label: 'Ver industrias', href: '/industrias/gastronomia', variant: 'ghost' },
    ]}
  />

  <!-- Outsourcing: servicio estrella -->
  <section class="section">
    <div class="container">
      <div class="outs reveal">
        <div class="outs-text">
          <span class="ribbon">Servicio estrella</span>
          <h2 class="h2 outs-title">Outsourcing<br />Administrativo</h2>
          <p class="lead">
            No es tercerizar tareas: es incorporar un equipo a tu operación. Liquidamos, conciliamos,
            presentamos y reportamos — con un equipo dedicado o por horas, según el tamaño de tu negocio.
          </p>
        </div>
        <ul class="outs-benefits">
          {OUTSOURCING_BENEFITS.map((b) => (
            <li><span class="outs-check" aria-hidden="true">→</span><span>{b}</span></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Las áreas de servicio -->
  <section class="section">
    <div class="container">
      <p class="eyebrow reveal">// Seis áreas, un solo equipo</p>
      <div class="areas-stack">
        {AREAS.map((a, i) => <ServiceBlock area={a} index={i} />)}
      </div>
    </div>
  </section>

  <!-- Complementarios -->
  <section class="section">
    <div class="container">
      <div class="compl reveal">
        <div>
          <span class="ribbon">También te acompañamos en</span>
          <h2 class="h2 compl-title">Servicios complementarios</h2>
        </div>
        <ul class="compl-list">
          {COMPLEMENTARIOS.map((c) => (
            <li><span class="compl-arrow" aria-hidden="true">→</span><span>{c}</span></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <CtaBanner title="¿Listos para sacarte la administración de encima?" />
</BaseLayout>

<style>
  .outs { display: grid; grid-template-columns: 1.3fr 1fr; gap: var(--space-lg); align-items: center; }
  .outs-title { margin-top: var(--space-md); }
  .outs-text .lead { margin-top: var(--space-md); max-width: 54ch; }
  .outs-benefits { display: grid; gap: 14px; }
  .outs-benefits li { display: flex; gap: 12px; align-items: center; font-size: 17px; font-weight: 600; }
  .outs-check { color: var(--gold); flex-shrink: 0; }
  @media (max-width: 820px) { .outs { grid-template-columns: 1fr; gap: var(--space-md); } }

  .areas-stack { margin-top: var(--space-md); display: grid; gap: var(--space-md); }

  .compl { display: grid; grid-template-columns: 1fr 1.2fr; gap: var(--space-lg); align-items: center; }
  .compl-title { margin-top: var(--space-md); }
  .compl-list { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-sm) var(--space-md); }
  .compl-list li { display: flex; gap: 10px; align-items: center; font-size: 16px; padding: var(--space-sm) 0; border-bottom: 1px solid var(--line); color: var(--ciaf-on-navy-80); }
  .compl-arrow { color: var(--ciaf-on-navy-55); flex-shrink: 0; }
  @media (max-width: 720px) { .compl { grid-template-columns: 1fr; gap: var(--space-md); } .compl-list { grid-template-columns: 1fr; } }
</style>
